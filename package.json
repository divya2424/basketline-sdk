{
  "name": "@divya2424/basketline-sdk",
  "version": "0.1.0",
  "description": "Send ad and shopper events to Basketline from any website: impressions, clicks and add-to-cart, with click-to-basket attributed server-side.",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "git+https://github.com/divya2424/basketline-sdk.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
