{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "rules": {
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/require-mock-type-parameters": "off"
  }
}
